# ==============================================================================
# MinIO Object Storage Configuration Template (BIGDATA_SIBI)
# ==============================================================================
# Copy this file to minio.env and update MINIO_ROOT_PASSWORD before running.
# Never commit minio.env containing actual production credentials to version control.
# ==============================================================================

# Root Admin Credentials
MINIO_ROOT_USER=sibiadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_MIN_8_CHARS

# Server Settings
MINIO_BROWSER=on
MINIO_REGION_NAME=us-east-1

# Target Buckets for Project BIGDATA_SIBI:
# 1. sibi-raw        -> Stores raw SIBI textbook PDFs and metadata
# 2. sibi-processed  -> Stores cleaned text tokens and bag-of-words TSV inputs
# 3. sibi-output     -> Stores MapReduce word frequency outputs and audit reports

