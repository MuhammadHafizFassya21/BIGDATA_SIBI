# ==============================================================================
# HADOOP CLUSTER CONFIGURATION (BIGDATA_SIBI - LOCALJOBRUNNER MODE)
# ==============================================================================
# Image Base: bde2020/hadoop-namenode:2.0.0-hadoop3.2.1-java8
#             bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
# Environment variables with prefixes CORE_CONF_, HDFS_CONF_, MAPRED_CONF_
# are translated into corresponding *-site.xml configuration files by /entrypoint.sh.
# ==============================================================================

# --- Cluster Metadata ---
CLUSTER_NAME=sibi_hadoop_cluster
TOGGLE_FRIENDLY_NAMES=true

# --- Core Configuration (core-site.xml) ---
# Default HDFS RPC URI pointed to internal namenode service port 9000
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_io_file_buffer_size=131072

# --- HDFS Configuration (hdfs-site.xml) ---
# Single-node DataNode setup requires replication factor 1
HDFS_CONF_dfs_replication=1
HDFS_CONF_dfs_namenode_name_dir=file:///hadoop/dfs/name
HDFS_CONF_dfs_datanode_data_dir=file:///hadoop/dfs/data
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_webhdfs_enabled=true

# --- MapReduce Configuration (mapred-site.xml) ---
# CRITICAL: Execute via LocalJobRunner (single-node local execution, NO YARN / NO RM)
MAPRED_CONF_mapreduce_framework_name=local
MAPRED_CONF_mapreduce_job_reduces=1
MAPRED_CONF_mapreduce_task_io_sort_mb=64
MAPRED_CONF_mapreduce_map_memory_mb=512
MAPRED_CONF_mapreduce_reduce_memory_mb=512

# --- JVM Memory Allocations ---
# Conservative heap size suited for 8 GB host RAM (free ~1.9 GB)
HADOOP_HEAPSIZE=512
HADOOP_NAMENODE_OPTS=-Xmx512m -Xms256m
HADOOP_DATANODE_OPTS=-Xmx384m -Xms256m

