*.env
.env
.env.*
!*.env.example
!configs/minio/minio.env.example

# ==========================================
# PYTHON ENVIRONMENT & CACHE
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# ==========================================
# ORIGINAL DATASET - DO NOT UPLOAD
# ==========================================
dataset/raw/
dataset/optional/

# ==========================================
# GENERATED TEXT DATA
# ==========================================
extracted_text/raw/
extracted_text/cleaned/

# Generated BoW datasets
dataset/processed/*.tsv

# ==========================================
